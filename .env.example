NODE_ENV=development
LOG_LEVEL=info
DATABASE_URL=postgres://postgres:postgres@localhost:5432/escola
TEST_DATABASE_URL=postgres://postgres:postgres@localhost:5432/escola_test
REDIS_URL=redis://localhost:6379

KMS_PROVIDER=local
# 32 random bytes, base64: node -e "console.log(require('crypto').randomBytes(32).toString('base64'))"
LOCAL_KMS_KEY=

GESTIB_BASE_URL=https://www3.caib.es/xestibback/families/
GESTIB_IDP_URL=https://idp.caib.es
GESTIB_MOCK_URL=http://localhost:4010
ALLOW_REAL_PORTAL=false
# Optional: system Chrome for Playwright if `npx playwright install chromium` isn't possible
CHROME_PATH=

# openssl rand -hex 32
JWT_SECRET=
APP_URL=http://localhost:8081
PUBLIC_API_URL=http://localhost:3000
LOCAL_BLOB_DIR=.data/blobs
ADMIN_TOKEN=

# AI. "fake" runs offline. Production: bedrock in an EU region with model IDs from your Bedrock console.
LLM_PROVIDER=fake
LLM_REGION=eu-west-3
LLM_MODEL_TRANSLATE=
LLM_MODEL_CHAT=
EMBEDDING_MODEL=cohere.embed-multilingual-v3

# Writes to the school, comma-separated. Empty = reply_message against the mock portal, none against real GestIB
# until each kind is verified on a real account (SPEC §9).
ENABLED_WRITERS=

# Optional: storage (S3 in an EU region), email, sign in with Apple/Google, push, billing
S3_BUCKET=
S3_REGION=eu-south-2
S3_KMS_KEY_ID=
EMAIL_PROVIDER=console
EMAIL_API_KEY=
EMAIL_FROM=
APPLE_CLIENT_ID=
GOOGLE_OAUTH_CLIENT_IDS=
EXPO_ACCESS_TOKEN=
REVENUECAT_WEBHOOK_SECRET=
SYNC_CONCURRENCY=2
SYNC_LOGIN_RATE_PER_MIN=2
