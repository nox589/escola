# Sync worker: BullMQ consumers + headless Chromium for GestIB. Needs >= 2 GB RAM.
#   docker build -f deploy/Dockerfile.worker -t escola-worker .
# The Playwright base image ships the Chromium build matching playwright@1.64.1.
FROM mcr.microsoft.com/playwright:v1.64.1-noble AS build
WORKDIR /app
RUN npm install -g pnpm@10.28.0
COPY . .
ENV PLAYWRIGHT_SKIP_BROWSER_DOWNLOAD=1
RUN pnpm install --frozen-lockfile --filter @escola/sync-worker... \
 && pnpm --filter @escola/sync-worker... build

FROM mcr.microsoft.com/playwright:v1.64.1-noble
WORKDIR /app
ENV NODE_ENV=production
COPY --from=build /app /app
USER pwuser
CMD ["node", "workers/sync/dist/main.js"]
