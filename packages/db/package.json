    "migrate:down": "tsx --env-file=../../.env src/cli.ts down"
  },
  "dependencies": {
    "@escola/shared": "workspace:*",
    "drizzle-orm": "^0.45.0",
    "pg": "^8.13.1"
  },
  "devDependencies": {
    "@types/pg": "^8.11.10",
    "drizzle-kit": "^0.31.0"
  }
}
